# Copy to .env (gitignored) or export in your shell. Never commit a real key.
# The value goes on the same line as the name, no quotes needed, nothing on the next line:
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# Optional. Only for an organisation-level key that is not scoped to a workspace: the API then
# rejects every request until it carries the workspace id (sent as the anthropic-workspace-id
# header). A workspace-scoped key needs nothing here; leave it empty.
ANTHROPIC_WORKSPACE_ID=

# Optional. An Anthropic-compatible gateway instead of api.anthropic.com, with the key that
# gateway gave you. The SDK appends /v1/messages itself, so give the part before /v1. For
# OpenCode Zen (endpoint https://opencode.ai/zen/v1/messages): ANTHROPIC_BASE_URL=https://opencode.ai/zen
ANTHROPIC_BASE_URL=

# Optional. The model id to request instead of the default named in src/main/claude.ts
# (claude-sonnet-5); gateways may expose Claude under a different id. Blank means the default.
ANTHROPIC_MODEL=
